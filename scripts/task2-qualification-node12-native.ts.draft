  const destination = spawn('docker', ['--context', CONTEXT, 'exec', '-i', names.scanner, '/bin/sh', '-c', 'cat > /work/image.tar && chmod 444 /work/image.tar'], { env: childEnv, stdio: ['pipe', 'ignore', 'ignore'] });
